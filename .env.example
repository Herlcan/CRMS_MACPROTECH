# Copy this file to .env before using docker-compose.prod.yml.
# Keep .env private. It contains production secrets for the shop computer.

COMPOSE_PROJECT_NAME=macprotech

# Keep 127.0.0.1 if the system is used only on this computer.
# Use 0.0.0.0 only if other trusted computers on the shop LAN must connect.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
PHPMYADMIN_PORT=8081
APP_IMAGE_TAG=prod

# HTTPS reverse proxy. Keep localhost for single-computer use.
# For shop LAN use, set HTTPS_HOSTNAME to a local name such as macprotech.local,
# set HTTPS_BIND_ADDRESS=0.0.0.0, and map that name to this computer's LAN IP.
HTTPS_HOSTNAME=localhost
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_HTTP_PORT=80
HTTPS_PORT=443

DB_NAME=crms_macprotech
DB_USER=macprotech
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Generate a real value before installing:
#   openssl rand -base64 32
# Then prefix it with base64:, for example base64:PASTE_RANDOM_VALUE_HERE
MACPROTECH_APP_KEY=

MACPROTECH_IDLE_TIMEOUT_SECONDS=1800

# Optional default SMTP settings. You can also configure these later in Settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
